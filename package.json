{
  "name": "ples",
  "version": "6.0.1",
  "description": "A tiny, CSS-first library for coordinating page-load and in-app-transition reveal animations, built on pagereveal.",
  "homepage": "https://github.com/lotva/ples#readme",
  "bugs": {
    "url": "https://github.com/lotva/ples/issues"
  },
  "license": "MIT",
  "author": "Denis Nalitov <connect@lotva.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotva/ples.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/runtime.iife.js",
    "./dist/await.iife.js",
    "./dist/navigation.iife.js",
    "./dist/ples.css",
    "./dist/effects/*.css",
    "./dist/scroll.css",
    "./dist/sequence.css",
    "./dist/await.css",
    "./dist/navigation.css"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./head": {
      "types": "./dist/head.d.mts",
      "import": "./dist/head.mjs"
    },
    "./astro": {
      "types": "./dist/astro.d.mts",
      "import": "./dist/astro.mjs"
    },
    "./eleventy": {
      "types": "./dist/eleventy.d.mts",
      "import": "./dist/eleventy.mjs"
    },
    "./vite": {
      "types": "./dist/vite.d.mts",
      "import": "./dist/vite.mjs"
    },
    "./runtime": "./dist/runtime.iife.js",
    "./await": "./dist/await.iife.js",
    "./navigation": "./dist/navigation.iife.js",
    "./styles": "./dist/ples.css",
    "./effects/relax": "./dist/effects/relax.css",
    "./effects/zoom": "./dist/effects/zoom.css",
    "./effects/screw": "./dist/effects/screw.css",
    "./effects/focus": "./dist/effects/focus.css",
    "./scroll": "./dist/scroll.css",
    "./sequence": "./dist/sequence.css",
    "./await.css": "./dist/await.css",
    "./navigation.css": "./dist/navigation.css"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "pnpm run test:browser && pnpm run test:integrations",
    "test:browser": "playwright test",
    "test:integrations": "pnpm run test:integrations:build && node --test tests/*.integration.mjs",
    "test:integrations:build": "pnpm run build && pnpm --dir fixtures/astro run build && pnpm --dir fixtures/eleventy run build && pnpm --dir fixtures/vite run build",
    "check:types": "tsc --noEmit",
    "check:scripts": "oxlint",
    "check:format": "oxfmt",
    "check:size": "pnpm run build && size-limit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.1.0",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.1.1",
    "astro": "^7.2.10",
    "bumpp": "^11.1.0",
    "eslint-plugin-prefer-let": "^4.2.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@11ty/eleventy": ">=3.0.0",
    "astro": ">=4.0.0",
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@11ty/eleventy": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "size-limit": [
    {
      "path": "dist/runtime.iife.js",
      "limit": "500 B"
    },
    {
      "path": "dist/ples.css",
      "limit": "500 B"
    },
    {
      "path": "dist/effects/relax.css",
      "limit": "180 B"
    },
    {
      "path": "dist/effects/zoom.css",
      "limit": "180 B"
    },
    {
      "path": "dist/effects/screw.css",
      "limit": "200 B"
    },
    {
      "path": "dist/effects/focus.css",
      "limit": "200 B"
    },
    {
      "path": "dist/scroll.css",
      "limit": "400 B"
    },
    {
      "path": "dist/sequence.css",
      "limit": "200 B"
    },
    {
      "path": "dist/await.iife.js",
      "limit": "500 B"
    },
    {
      "path": "dist/await.css",
      "limit": "150 B"
    },
    {
      "path": "dist/navigation.iife.js",
      "limit": "220 B"
    },
    {
      "path": "dist/navigation.css",
      "limit": "150 B"
    }
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.2.1"
}
