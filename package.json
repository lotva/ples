{
  "name": "ples",
  "version": "1.0.0",
  "description": "A starter for creating a TypeScript package.",
  "homepage": "https://github.com/lotva/ples#readme",
  "bugs": {
    "url": "https://github.com/lotva/ples/issues"
  },
  "license": "MIT",
  "author": "Denis Nalitov <connect@lotva.ru>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lotva/ples.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./ples.css": "./dist/ples.css"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "playwright test",
    "check:types": "tsc --noEmit",
    "check:scripts": "oxlint",
    "check:format": "oxfmt",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@logux/oxc-configs": "^1.1.0",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.1.1",
    "bumpp": "^11.1.0",
    "eslint-plugin-prefer-let": "^4.2.2",
    "lightningcss": "^1.33.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.2.1"
}
